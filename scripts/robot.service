[Unit]
Description=Target Nav Robot Drivers (LiDAR, Arduino, Odometry)
After=network.target seatd.service
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root
ExecStartPre=/bin/sleep 3
ExecStart=/root/ros2_ws/src/target_nav/scripts/autostart.sh
ExecStop=/bin/bash -c 'pkill -f "ros2 launch target_nav" || true; sleep 1; pkill -9 -f "rplidar_node|arduino_driver|odometry_node|robot_state_publisher" || true; fuser -k /dev/ttyACM0 /dev/ttyUSB0 2>/dev/null || true'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

Environment="HOME=/root"
Environment="ROS_DOMAIN_ID=0"
Environment="ROS_LOCALHOST_ONLY=0"
Environment="XDG_RUNTIME_DIR=/run/user/996"
Environment="WAYLAND_DISPLAY=wayland-1"

[Install]
WantedBy=multi-user.target
